;; aidesk — AI Design Desk の appview（エッジ面）。
;;
;; Worker は ClojureScript である。superproject CLAUDE.md の runtime 順序
;; （kotoba wasm > clojurewasm > ClojureScript > nbb）に TypeScript は無い。
;; 入口を .kotoba ではなく cljs に置くのは ADR-2606290000 の判断で、kotoba の
;; ingress capability が :native-aot / :wasm-aot とも pending だからである。
;; 判断の形をした部分は .cljc に置いてあり（route.cljc / view.cljc）、
;; ブラウザ無しでテストでき、ingress が qualify した時に最初に .kotoba へ移る。
;;
;; DDS の sha は git で存在を確認して固定した（`git cat-file -t` = commit、
;; kotoba-lang/main から到達可能）。GitHub の commits API は実在する commit に
;; 404 を返すことがあるので、pin の確認に使わない。
{:paths ["src"]
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       io.github.kotoba-lang/jp-go-digital-design-system
        {:git/url "https://github.com/kotoba-lang/jp-go-digital-design-system"
         :git/sha "2e2d191e9e1731ce6865c79dab163a5d74249053"}}
 :aliases
 {:cljs {:extra-deps {org.clojure/clojurescript {:mvn/version "1.11.132"}
                      thheller/shadow-cljs {:mvn/version "2.28.20"}}}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}}}
