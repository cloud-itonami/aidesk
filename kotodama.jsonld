      "subscriber"
    ],
    "requiredTrustLevel": "medium",
    "sensitivity": "internal"
  },
  "kpi": [
    "設計ジョブ完了率",
    "tsukuru handoff 成功率",
    "STEP ファイル生成 IoU"
  ],
